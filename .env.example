# Copy to .env and fill in. Never commit .env.

# --- Slack ---
# https://api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-

# https://api.slack.com/apps → Basic Information → App-Level Tokens (xapp-...)
# Socket Mode 사용 시에만 필요
SLACK_APP_TOKEN=xapp-

# --- LLM providers ---
# Gemini — Stage 2 필터링 + Pipeline B 요약 메인. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude — 품질 검증·sanity 비교용. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- NCBI / PubMed ---
# Optional — 발급 시 rate limit 3→10 req/sec. https://account.ncbi.nlm.nih.gov/
NCBI_API_KEY=
NCBI_EMAIL=dosoyang@korea.ac.kr

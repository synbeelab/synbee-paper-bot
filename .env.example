# Copy to .env and fill in. Never commit .env.

# --- Slack ---
# https://api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-

# https://api.slack.com/apps → Basic Information → App-Level Tokens (xapp-...)
# Socket Mode 사용 시에만 필요
SLACK_APP_TOKEN=xapp-

# --- LLM providers ---
# Gemini — Stage 2 필터링 + Pipeline B 요약 메인. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude — 품질 검증·sanity 비교용. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Gmail (스팸함 구제 봇 전용) ---
# Google Cloud Console → Credentials → OAuth client ID → "Desktop app"
# (Gmail API 활성화 필요). 발급 후 아래 명령으로 refresh token을 1회 발급:
#   python scripts/gmail_auth_setup.py --client-id ... --client-secret ...
# 스코프는 gmail.modify — 라벨 이동만 가능하고 영구 삭제는 불가능하다.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- NCBI / PubMed ---
# Optional — 발급 시 rate limit 3→10 req/sec. https://account.ncbi.nlm.nih.gov/
NCBI_API_KEY=
NCBI_EMAIL=dosoyang@korea.ac.kr

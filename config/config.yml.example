# SynBEE Lab Paper Bot — main configuration template
#
# Copy to config/config.yml and fill in. Do NOT commit config.yml (.gitignored).
# Queries are auto-generated from journals.yml + keywords.yml via scripts/build_query.py.

# --- Stage 1: paper sources ---
sources:
  pubmed:
    enabled: true
    # Auto-build via build_query.py if null
    query: null
    since_days: 1                    # cron interval
  biorxiv:
    enabled: true
    query: null
    since_days: 1
  arxiv:
    enabled: false                   # 처음엔 비활성화 — 노이즈 많음
    categories: ["q-bio.BM", "q-bio.MN"]
  rss:
    enabled: true                    # journals.yml의 rss_feeds 사용
    since_days: 1

# --- Stage 2: LLM relevance filter ---
llm_filter:
  enabled: true
  provider: "gemini"                 # "gemini" | "anthropic" | "openai" | "ollama"
  model: "gemini-2.5-flash"          # Primary. Free tier 250 RPD/일.
  fallback_models:                   # Primary 실패(503/429/SDK error) 시 순서대로 시도
    - "gemini-2.5-flash-lite"        #   Free tier 20 RPD — 응급 fallback
    # - "gemini-2.5-pro"             #   Free tier 50 RPD — quality 우선이면 활성화
  prompt_path: "config/filter_prompt.md"
  min_score: 6                       # filter_prompt.md의 score 6 미만은 드롭
  parallel_requests: 4
  timeout_seconds: 30
  # API key는 .env에서 GEMINI_API_KEY 로드

# --- Slack ---
slack:
  enabled: true
  bot_token_env: "SLACK_BOT_TOKEN"
  channels:
    daily_digest: ""                 # e.g., "C0XXXXXXXX" — #papers-daily
    high_priority: ""                # e.g., 점수 9+ 별도 채널 (#papers-priority)
    test: ""                         # 운영 전 테스트 채널
  use_test_channel: true             # 첫 1주는 true 권장
  # 게시 편수 상한. null = 무제한 (기본).
  # 상한을 두면 필터를 통과한 논문이 조용히 버려지고, 직후 seen.db에 기록되어
  # 다시는 평가되지 않는다 → 영구 누락. 알림 누락 방지가 비용보다 우선이므로 무제한.
  # 폭주(대량 backfill 등)를 막아야 할 때만 숫자를 넣을 것.
  max_posts_per_run: null

# --- Storage ---
storage:
  seen_db: "data/seen.db"            # SQLite — 중복 푸시 방지

# --- Wiki queue (GitHub Issue + local raw/ ingest) ---
# "📥 위키 후보 등록" 버튼 클릭 시 wiki-queue 라벨 GitHub Issue 생성 페이지를 엶.
# 사용자가 Submit → process_wiki_queue.py로 raw/에 markdown 저장 → 수동 wiki 정리.
wiki_queue:
  github_repo: "synbeelab/synbee-paper-bot"           # "owner/repo" — 빈 문자열이면 버튼 숨김
  vault_raw_dir: "D:/Obsidian_Vault/Dongsoo/raw"      # 로컬 SynBEE Wiki raw/ 디렉터리

# --- Schedule (informational — 실제 cron은 .github/workflows에서 설정) ---
schedule:
  cron: "0 8 * * 1-5"                # 평일 KST 08:00
  timezone: "Asia/Seoul"

# --- Weekly journal-sweep digest (delta vs daily) ---
# Journal-only PubMed sweep (no keyword gate) → dedup vs seen.db (excludes
# everything the daily bot already saw) → LLM filter → post the delta.
weekly:
  enabled: true
  channel: "C0BKDNLRFAT"             # #논문-알림 (hardcoded)
  since_days: 7
  min_score: 6
  max_posts: null                    # null = 무제한 (위 max_posts_per_run 주석 참고)
  llm:
    provider: "gemini"               # paid Gemini tier (shared GEMINI_API_KEY) — no free-tier cap
    model: "gemini-2.5-flash"
    fallback_models:
      - "gemini-2.5-flash-lite"
